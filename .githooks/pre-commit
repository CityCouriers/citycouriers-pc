#!/usr/bin/env bash
# Hook pre-commit repo pc: te same kontrole co w CI (poza skanerem sekretów, który wymaga binarki gitleaks).
# Włączenie: composer hooks (git config core.hooksPath .githooks). Bez --no-verify.
#
# Zakres: bramki uruchamiane są dla typów zmienionych plików (scripts/quality/hook-scope.js, docs/bramki.md,
# sekcja „Zakres plików bramki”). Commit z samym .md nie uruchamia PHPStan ani testów, bo nic w nich nie sprawdzą.
# Każda niepewność (pusty stage, nieznany plik, błąd klasyfikatora, brak node) daje pełny zestaw.
# PC_HOOK_SCOPE=all wymusza pełny zestaw. Lista bramek musi zgadzać się ze skryptem (pilnuje tego test/hook-scope.test.js).
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

all_gates="privacy lint stan smells test negative process"

if command -v node >/dev/null 2>&1; then
    if ! scope="$(node scripts/quality/hook-scope.js)"; then
        echo "pre-commit: klasyfikator zakresu zawiódł, uruchamiam pełny zestaw bramek." >&2
        scope="$all_gates"
    fi
else
    echo "pre-commit: brak node, uruchamiam pełny zestaw bramek bez testów skryptów procesu (w CI biegną zawsze)." >&2
    scope="privacy lint stan smells test negative"
fi

for gate in $scope; do
    echo "[pre-commit] $gate" >&2
    case "$gate" in
        privacy) composer privacy ;;
        lint) composer lint ;;
        stan) composer stan ;;
        smells) composer smells ;;
        test) composer test ;;
        negative) composer negative ;;
        process) npm test --silent ;;
        *)
            echo "pre-commit: nieznana bramka '$gate'" >&2
            exit 1
            ;;
    esac
done
